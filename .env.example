# Dirección del proxy en tu LAN para un teléfono físico (localhost solo sirve en la PC).
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
# Clave pública restringida por package/SHA para mapas nativos Android (opcional).
GOOGLE_MAPS_API_KEY=
# SOLO servidor: nunca usar el prefijo EXPO_PUBLIC_ para credenciales.
N2YO_API_KEY=
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=
PORT=3001
HOST=0.0.0.0
# Orígenes web adicionales separados por coma, si se publica el proxy.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
