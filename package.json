{
  "name": "satellite-tracker-tp7",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "server": "tsx server/index.ts",
    "dev": "concurrently -k -n API,APP \"npm:server\" \"npm:web\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "seed": "tsx scripts/seed.ts",
    "assets:atlas": "node scripts/make-atlas.mjs",
    "export:web": "expo export --platform web",
    "check": "npm run typecheck && npm test",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-background-task": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "satellite.js": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^10.0.6",
    "d3-geo": "^3.1.1",
    "dotenv": "^18.0.9",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  }
}
